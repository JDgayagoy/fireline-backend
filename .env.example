# ==============================================================================
# Gas & Fire Monitor PWA - Server Environment Variables
# ==============================================================================

# Server Port
PORT=3001

# Supabase Configuration
# Obtain these from your Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=eyJhbGciOi...your-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your-service-role-key

# ------------------------------------------------------------------------------
# 1. Web Push Notifications (VAPID)
# ------------------------------------------------------------------------------
# Generate keys with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=BEl62iUYgUivxIkv69yViEuiBIa...your-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@example.com

# ------------------------------------------------------------------------------
# 2. Cloud SMS Escalation (Fallback if ESP32 SIM800L is unreachable)
# ------------------------------------------------------------------------------
# Optional Twilio credentials (if using cloud SMS instead of SIM800L hardware)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_PHONE=+1XXXXXXXXXX


# ------------------------------------------------------------------------------
# 4. AI Diagnostics (Optional: LLM Integration)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key
